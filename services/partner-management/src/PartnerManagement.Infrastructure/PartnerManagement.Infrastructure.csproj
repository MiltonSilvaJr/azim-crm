<Project Sdk="Microsoft.NET.Sdk">
  <!--
    PartnerManagement.Infrastructure
    Papel: adapters concretos — EF Core (PartnerManagementDbContext, PartnerRepository,
           migrations), TenantContext (filtro global de tenant_id + SET app.current_tenant),
           RLS interceptor de conexão, Outbox transacional (OutboxMessage, OutboxPublisher),
           Pub/Sub publisher, PartnerPiiMasker, AuditPublisher (IAuditPublisher),
           PartnerCommissionReadAdapter (IPartnerCommissionReadPort), CanonicalRoleProvider,
           IdempotencyKeyRepository e IClock.
    Regra de dependência: Infrastructure -> Application, Domain, Contracts.
    Infrastructure é o único projeto autorizado a usar EF Core, Npgsql, Polly,
    GCP SDKs e drivers de mensageria.
    Módulo: BC-03 Partner Management (design §3, design §6).
  -->
  <PropertyGroup>
    <AssemblyName>PartnerManagement.Infrastructure</AssemblyName>
    <RootNamespace>PartnerManagement.Infrastructure</RootNamespace>
    <Description>Adapters de infraestrutura do módulo partner-management: EF Core, tenant filter, RLS interceptor, Outbox/Pub/Sub, PiiMasker, AuditPublisher e adapters de leitura. Único projeto autorizado a usar drivers de persistência e mensageria.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PartnerManagement.Application\PartnerManagement.Application.csproj" />
    <ProjectReference Include="..\PartnerManagement.Domain\PartnerManagement.Domain.csproj" />
    <ProjectReference Include="..\PartnerManagement.Contracts\PartnerManagement.Contracts.csproj" />
  </ItemGroup>

  <!-- InternalsVisibleTo: expõe internal sealed adapters ao projeto de testes de integração -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>PartnerManagement.Infrastructure.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core 9.0.6 — versão alinhada com os demais módulos do repositório -->
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.6" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.6">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.6" />
    <!-- Npgsql 9.0.4 — driver PostgreSQL alinhado com os demais módulos -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.16.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.16.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.13.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.13.0" />
    <!-- Resiliência: retry, circuit breaker, timeout (Polly v8 — design §15, TASK-28) -->
    <PackageReference Include="Polly" Version="8.5.2" />
    <!-- Serilog: logs estruturados (RNF 5.1) -->
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <!-- Health checks: live e ready endpoints -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.0" />
    <!-- HTTP client para PartnerCommissionReadAdapter (design §6.4) -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>
</Project>
