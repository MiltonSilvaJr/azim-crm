<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Digest.Api.Tests
    Foco: autenticação OIDC do trigger (401/403), resposta 202,
          contrato do PerTenantConsumer Pub/Sub (TASK-21..TASK-22).
    Usa WebApplicationFactory para testes de API (design §13).
    Coverlet configurado via Directory.Build.props.
  -->
  <PropertyGroup>
    <AssemblyName>Digest.Api.Tests</AssemblyName>
    <RootNamespace>Digest.Api.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Api sob teste -->
    <ProjectReference Include="..\..\src\Digest.Api\Digest.Api.csproj" />
    <!-- Contratos: DTOs do trigger e enums -->
    <ProjectReference Include="..\..\src\Digest.Contracts\Digest.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- WebApplicationFactory: testes de integração da API -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <!-- NSubstitute: mocks dos handlers MediatR -->
    <PackageReference Include="NSubstitute" Version="5.3.0" />
  </ItemGroup>
</Project>
