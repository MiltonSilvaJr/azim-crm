<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Digest.Architecture.Tests
    Foco: regra de dependência Clean Architecture (design §3.1);
          proibição de EF Core/HTTP/Pub/Sub SDK em Domain;
          proibição de mapeamento de tabelas alheias (opportunities, activities, goals, users).
    Executa em 100% dos PRs; falha o CI em caso de violação (TASK-02, RNF 1, Req 6.2).
    Coverlet configurado via Directory.Build.props.
  -->
  <PropertyGroup>
    <AssemblyName>Digest.Architecture.Tests</AssemblyName>
    <RootNamespace>Digest.Architecture.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Referencia todos os projetos de produção para inspeção de assemblies -->
    <ProjectReference Include="..\..\src\Digest.Domain\Digest.Domain.csproj" />
    <ProjectReference Include="..\..\src\Digest.Application\Digest.Application.csproj" />
    <ProjectReference Include="..\..\src\Digest.Infrastructure\Digest.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Digest.Api\Digest.Api.csproj" />
    <ProjectReference Include="..\..\src\Digest.Contracts\Digest.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- NetArchTest para regras de arquitetura -->
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>
</Project>
