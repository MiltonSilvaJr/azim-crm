<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Digest.Contracts
    Papel: contratos públicos estáveis do módulo digest.
    Contém: DTOs do trigger, contrato do evento digest.email_sent.v1, enums de status.

    Regra de dependência (design §3.1): Contracts -> ∅ (sem dependências internas).
    Portabilidade: zero dependências de provedor ou framework de aplicação aqui.
  -->
  <PropertyGroup>
    <AssemblyName>Digest.Contracts</AssemblyName>
    <RootNamespace>Digest.Contracts</RootNamespace>
    <Description>Contratos públicos estáveis do módulo digest: DTOs, evento digest.email_sent.v1, enums de status. Sem dependências internas (design §3.1).</Description>
  </PropertyGroup>
</Project>
