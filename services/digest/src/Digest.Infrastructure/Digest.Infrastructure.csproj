<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Digest.Infrastructure
    Papel: adaptadores de infraestrutura — persistência, RLS, repositórios, outbox,
           adaptadores das portas de leitura, factory de token, renderer de template.
    Contém: DigestDbContext, TenantConnectionInterceptor, EmailDigestLogRepository,
            DigestActionTokenRepository, ActionTokenFactory, OutboxPublisher,
            EmailTemplateRenderer, adaptadores Polly das portas de leitura, IClock, DI.

    Regra de dependência (design §3.1): Infrastructure -> Application, Domain.
    Proibição: sem referência a Digest.Api.
    EF Core 9.0.6 + Npgsql 9.0.4 (TASK-01 nota: versões definidas pelo projeto).
  -->
  <PropertyGroup>
    <AssemblyName>Digest.Infrastructure</AssemblyName>
    <RootNamespace>Digest.Infrastructure</RootNamespace>
    <Description>Camada Infrastructure do módulo digest: persistência EF Core/PostgreSQL, RLS, repositórios, outbox, adaptadores Polly das portas de leitura e factory de token (design §3.1).</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Infrastructure -> Application (regra de dependência design §3.1) -->
    <ProjectReference Include="..\Digest.Application\Digest.Application.csproj" />
    <!-- Infrastructure -> Domain (regra de dependência design §3.1) -->
    <ProjectReference Include="..\Digest.Domain\Digest.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core + Npgsql: persistência em Cloud SQL PostgreSQL (design §6.1, DD-002) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.6" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.6" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <!-- NodaTime Npgsql: mapeamento de tipos IANA no banco (DD-012) -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NodaTime" Version="9.0.4" />
    <!-- Polly: resiliência das portas de leitura (design §6.4, RNF 5) -->
    <PackageReference Include="Polly" Version="8.7.0" />
    <PackageReference Include="Polly.Extensions.Http" Version="3.0.0" />
    <!-- Microsoft.Extensions.Http.Polly: integração Polly + HttpClientFactory -->
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="9.0.6" />
  </ItemGroup>
</Project>
