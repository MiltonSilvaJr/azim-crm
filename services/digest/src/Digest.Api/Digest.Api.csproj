<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Digest.Api
    Papel: borda HTTP do worker — trigger OIDC/WIF e consumer Pub/Sub.
    Contém: DigestTriggerEndpoint (/internal/digest/trigger), PerTenantConsumer (Pub/Sub push),
            health checks (live/ready), startup e DI.

    Regra de dependência (design §3.1): Api -> Application, Infrastructure, Contracts.
    RNF 8: trigger responde 202 antes de concluir processamento (assíncrono).
    Segurança: OIDC/WIF no trigger; Pub/Sub push autenticado no consumer (design §10).
  -->
  <PropertyGroup>
    <AssemblyName>Digest.Api</AssemblyName>
    <RootNamespace>Digest.Api</RootNamespace>
    <Description>Borda HTTP do azim-digest-worker: DigestTriggerEndpoint (OIDC/WIF), PerTenantConsumer (Pub/Sub push) e health checks (design §3.1, §8, §10).</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Api -> Application (regra de dependência design §3.1) -->
    <ProjectReference Include="..\Digest.Application\Digest.Application.csproj" />
    <!-- Api -> Infrastructure (regra de dependência design §3.1) -->
    <ProjectReference Include="..\Digest.Infrastructure\Digest.Infrastructure.csproj" />
    <!-- Api -> Contracts (regra de dependência design §3.1) -->
    <ProjectReference Include="..\Digest.Contracts\Digest.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MediatR 12.x: DI nativo embutido (AddMediatR disponível em MediatR 12+) -->
    <PackageReference Include="MediatR" Version="12.4.1" />
    <!-- Autenticação OIDC/WIF: valida token JWT do Cloud Scheduler (RNF 7.1, design §10) -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.6" />
    <!-- FluentValidation: AddValidatorsFromAssembly no startup -->
    <PackageReference Include="FluentValidation" Version="11.11.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />
    <!-- Health Checks: live/ready com verificação de DbContext (design §8.2) -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="9.0.6" />
  </ItemGroup>
</Project>
