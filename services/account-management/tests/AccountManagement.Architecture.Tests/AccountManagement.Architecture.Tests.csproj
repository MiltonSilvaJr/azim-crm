<Project Sdk="Microsoft.NET.Sdk">
  <!--
    AccountManagement.Architecture.Tests
    Foco: regra de dependência entre camadas conforme design §3.
    Executa em 100% dos PRs; falha o CI em caso de violação.
    Mapeia: design §2 (princípios), design §3 (regras de dependência), TASK-01 (ST-01).

    Regra de dependência validada:
      Api            -> Application, Infrastructure, Contracts (permitido)
      Application    -> Domain, Contracts (permitido; NUNCA Infrastructure)
      Infrastructure -> Application, Domain, Contracts (permitido)
      Domain         -> (nenhum projeto interno)
      Contracts      -> (nenhum projeto interno)

    Coverlet configurado via Directory.Build.props.
  -->
  <PropertyGroup>
    <AssemblyName>AccountManagement.Architecture.Tests</AssemblyName>
    <RootNamespace>AccountManagement.Architecture.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- NetArchTest para regras de arquitetura -->
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Referencia todos os projetos de produção para inspeção de assemblies -->
    <ProjectReference Include="..\..\src\AccountManagement.Contracts\AccountManagement.Contracts.csproj" />
    <ProjectReference Include="..\..\src\AccountManagement.Domain\AccountManagement.Domain.csproj" />
    <ProjectReference Include="..\..\src\AccountManagement.Application\AccountManagement.Application.csproj" />
    <ProjectReference Include="..\..\src\AccountManagement.Infrastructure\AccountManagement.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\AccountManagement.Api\AccountManagement.Api.csproj" />
  </ItemGroup>
</Project>
