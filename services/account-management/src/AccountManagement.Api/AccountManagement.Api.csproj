<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    AccountManagement.Api
    Papel: controllers REST (AccountsController, ContactsController), middleware
           (CorrelationIdMiddleware, ExceptionHandlingMiddleware), mapeamento DTO -> command/query,
           health checks e configuração do pipeline ASP.NET Core.
    Regra de dependência: Api -> Application, Infrastructure, Contracts.
    Nenhuma lógica de negócio nos controllers — tudo delegado para Application.
  -->
  <PropertyGroup>
    <AssemblyName>AccountManagement.Api</AssemblyName>
    <RootNamespace>AccountManagement.Api</RootNamespace>
    <Description>Pipeline HTTP, controllers REST e middleware do módulo account-management. Nenhuma lógica de negócio nos controllers (Clean Architecture).</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AccountManagement.Application\AccountManagement.Application.csproj" />
    <ProjectReference Include="..\AccountManagement.Infrastructure\AccountManagement.Infrastructure.csproj" />
    <ProjectReference Include="..\AccountManagement.Contracts\AccountManagement.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Autenticação JWT (Req 9, rule jwt-permissions.md) -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <!-- OpenAPI/Swagger (TASK-15) -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.3.1" />
    <!-- FluentValidation DI extensions -->
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />
  </ItemGroup>
</Project>
