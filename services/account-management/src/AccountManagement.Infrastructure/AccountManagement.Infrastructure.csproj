<Project Sdk="Microsoft.NET.Sdk">
  <!--
    AccountManagement.Infrastructure
    Papel: adapters concretos — EF Core (AccountManagementDbContext, AccountRepository,
           migrations), TenantContext (filtro global de tenant_id), Outbox worker,
           Pub/Sub publisher, PiiMasker, AuditPublisher, OpportunityReadAdapter,
           ActivityReadAdapter (HTTP/gRPC interno com mTLS), IdempotencyKeyRepository, IClock.
    Regra de dependência: Infrastructure -> Application, Domain, Contracts.
    Infrastructure é o único projeto autorizado a usar EF Core, Npgsql, Polly,
    GCP SDKs e drivers de mensageria.
  -->
  <PropertyGroup>
    <AssemblyName>AccountManagement.Infrastructure</AssemblyName>
    <RootNamespace>AccountManagement.Infrastructure</RootNamespace>
    <Description>Adapters de infraestrutura do módulo account-management: EF Core, tenant filter, Outbox/Pub/Sub, PiiMasker, AuditPublisher e adapters de leitura. Único projeto autorizado a usar drivers de persistência e mensageria.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AccountManagement.Application\AccountManagement.Application.csproj" />
    <ProjectReference Include="..\AccountManagement.Domain\AccountManagement.Domain.csproj" />
    <ProjectReference Include="..\AccountManagement.Contracts\AccountManagement.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core 9.0.6 — versão alinhada com os demais módulos do repositório -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.6" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.6">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.6" />
    <!-- Npgsql 9.0.4 — driver PostgreSQL alinhado com os demais módulos -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <!-- Resiliência: retry, circuit breaker, timeout (Polly) -->
    <PackageReference Include="Polly" Version="8.5.2" />
    <!-- Serilog: logs estruturados (RNF 9.1) -->
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <!-- Health checks: live e ready endpoints -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.0" />
    <!-- HTTP client para adapters externos (OpportunityReadAdapter, ActivityReadAdapter) -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>
</Project>
