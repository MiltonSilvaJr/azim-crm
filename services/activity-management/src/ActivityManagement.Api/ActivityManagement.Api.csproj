<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    ActivityManagement.Api
    Papel: controllers REST (ActivitiesController, DigestActionsController, InternalController),
           middleware (CorrelationIdMiddleware, ExceptionHandlingMiddleware), mapeamento
           DTO -> command/query, health checks e configuração do pipeline ASP.NET Core.
    Regra de dependência: Api -> Application, Infrastructure, Contracts.
    Nenhuma lógica de negócio nos controllers — tudo delegado para Application.
    Mapeia: design §3, design §8 (API Contracts).
  -->
  <PropertyGroup>
    <AssemblyName>ActivityManagement.Api</AssemblyName>
    <RootNamespace>ActivityManagement.Api</RootNamespace>
    <Description>Pipeline HTTP, controllers REST e middleware do módulo activity-management. Nenhuma lógica de negócio nos controllers (Clean Architecture).</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ActivityManagement.Application\ActivityManagement.Application.csproj" />
    <ProjectReference Include="..\ActivityManagement.Infrastructure\ActivityManagement.Infrastructure.csproj" />
    <ProjectReference Include="..\ActivityManagement.Contracts\ActivityManagement.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Autenticação JWT (Req 13.4, rule jwt-permissions.md) -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
    <!-- OpenAPI/Swagger (design §8, TASK-18) -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.3.1" />
    <!-- FluentValidation DI extensions -->
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />
  </ItemGroup>
</Project>
