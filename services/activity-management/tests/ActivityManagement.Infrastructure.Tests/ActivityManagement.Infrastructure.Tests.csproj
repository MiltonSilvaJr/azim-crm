<Project Sdk="Microsoft.NET.Sdk">
  <!--
    ActivityManagement.Infrastructure.Tests
    Foco: repositório (ActivityRepository), filtro global de tenant (HasQueryFilter),
          RLS falha-fechada (TenantConnectionInterceptor), migrations (activities,
          digest_action_tokens, outbox_messages, audit_logs), constraints de schema
          (DD-001: chk_activities_completed_consistency), trigger de imutabilidade de
          audit_logs, Outbox relay, PiiMasker, AuditPublisher e DigestActionTokenAdapter.
    Infra de teste: Testcontainers + PostgreSQL real (não SQLite).
    PBT obrigatório: cross-tenant gate CI obrigatório (RNF 1.3, ADR-0001).
    Meta de cobertura: Infrastructure >= 70% (critério de fechamento da Onda 4).
    Mapeia: design §13 (testes), TASK-13..TASK-17.
  -->
  <PropertyGroup>
    <AssemblyName>ActivityManagement.Infrastructure.Tests</AssemblyName>
    <RootNamespace>ActivityManagement.Infrastructure.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ActivityManagement.Infrastructure\ActivityManagement.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\ActivityManagement.Application\ActivityManagement.Application.csproj" />
    <ProjectReference Include="..\..\src\ActivityManagement.Domain\ActivityManagement.Domain.csproj" />
    <ProjectReference Include="..\..\src\ActivityManagement.Contracts\ActivityManagement.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Testcontainers para PostgreSQL real em testes de integração -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.4.0" />
    <!-- NSubstitute: mock de serviços externos (Pub/Sub, etc.) -->
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <!-- Npgsql: conexão direta para verificações de schema RLS/REVOKE -->
    <PackageReference Include="Npgsql" Version="9.0.4" />
    <!-- FsCheck e FluentAssertions já vêm do Directory.Build.props -->
  </ItemGroup>
</Project>
