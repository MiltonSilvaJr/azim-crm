<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Organization.Architecture.Tests
    Foco: regra de dependência entre camadas conforme design §3.
    Executa em 100% dos PRs; falha o CI em caso de violação.
    Mapeia: design §2 (princípios), §3 (regras de dependência), TASK-02.

    Regra de dependência validada:
      Api            -> Application, Infrastructure, Contracts (permitido)
      Application    -> Domain, Contracts (permitido; NUNCA Infrastructure)
      Infrastructure -> Application, Domain, Contracts (permitido)
      Domain         -> (nenhum projeto interno)
      Contracts      -> (nenhum projeto interno)

    Coverlet configurado via Directory.Build.props.
  -->
  <PropertyGroup>
    <AssemblyName>Organization.Architecture.Tests</AssemblyName>
    <RootNamespace>Organization.Architecture.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- NetArchTest para regras de arquitetura -->
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Referencia todos os projetos de produção para inspeção de assemblies -->
    <ProjectReference Include="..\..\src\Organization.Contracts\Organization.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Organization.Domain\Organization.Domain.csproj" />
    <ProjectReference Include="..\..\src\Organization.Application\Organization.Application.csproj" />
    <ProjectReference Include="..\..\src\Organization.Infrastructure\Organization.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Organization.Api\Organization.Api.csproj" />
  </ItemGroup>
</Project>
