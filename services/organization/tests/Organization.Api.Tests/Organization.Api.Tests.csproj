<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Organization.Api.Tests
    Foco: contratos REST, autorização papel × operação (permissão e negação),
          isolamento entre tenants, anti-enumeração.
    Usa WebApplicationFactory para testes de integração da API.
    Cobertura meta: ≥80% para endpoints.
    Coverlet configurado via Directory.Build.props.
  -->
  <PropertyGroup>
    <AssemblyName>Organization.Api.Tests</AssemblyName>
    <RootNamespace>Organization.Api.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Organization.Api\Organization.Api.csproj" />
    <ProjectReference Include="..\..\src\Organization.Application\Organization.Application.csproj" />
    <ProjectReference Include="..\..\src\Organization.Contracts\Organization.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Organization.Infrastructure\Organization.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- WebApplicationFactory para testes de API com host real -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <!-- EF Core in-memory: substitui Postgres nas integrações de API (repositórios são mockados) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.6" />
    <!-- JWT geração para testes de auth -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.12.1" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.12.1" />
  </ItemGroup>
</Project>
