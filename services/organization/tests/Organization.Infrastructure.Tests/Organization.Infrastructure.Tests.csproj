<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Organization.Infrastructure.Tests
    Foco: repositórios EF Core, RLS e global filter (isolamento multi-tenant),
          Outbox/Inbox, cache Redis. PBTs: PBT-01.
    Usa Testcontainers para Postgres e Redis (testes de integração reais).
    Cobertura meta: ≥70% em Organization.Infrastructure.
    Coverlet configurado via Directory.Build.props.
  -->
  <PropertyGroup>
    <AssemblyName>Organization.Infrastructure.Tests</AssemblyName>
    <RootNamespace>Organization.Infrastructure.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Organization.Domain\Organization.Domain.csproj" />
    <ProjectReference Include="..\..\src\Organization.Application\Organization.Application.csproj" />
    <ProjectReference Include="..\..\src\Organization.Infrastructure\Organization.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Organization.Contracts\Organization.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Testcontainers: containers efêmeros Postgres e Redis para testes de integração -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.4.0" />
    <PackageReference Include="Testcontainers.Redis" Version="4.4.0" />
    <!-- EF Core Design: migrations e scaffolding em testes -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.6">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NSubstitute" Version="5.3.0" />
  </ItemGroup>
</Project>
