<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Organization.Api
    Papel: controllers REST (BusinessUnit, User, Invitation, pipeline config),
           middleware RBAC, mapeamento DTO → command/query, health checks,
           configuração do pipeline ASP.NET Core.
    Regra de dependência: Api -> Application, Infrastructure, Contracts.
    Nenhuma lógica de negócio nos controllers — tudo delegado para Application.
  -->
  <PropertyGroup>
    <AssemblyName>Organization.Api</AssemblyName>
    <RootNamespace>Organization.Api</RootNamespace>
    <Description>Pipeline HTTP, controllers REST e middleware RBAC do módulo organization. Nenhuma lógica de negócio nos controllers (Clean Architecture).</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Organization.Application\Organization.Application.csproj" />
    <ProjectReference Include="..\Organization.Infrastructure\Organization.Infrastructure.csproj" />
    <ProjectReference Include="..\Organization.Contracts\Organization.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Autenticação JWT (RNF 2) -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <!-- OpenAPI/Swagger (TASK-22) -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.3.1" />
    <!-- FluentValidation DI extensions -->
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />
  </ItemGroup>
</Project>
