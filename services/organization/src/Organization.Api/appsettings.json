{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Organization": "Host=localhost;Database=organization;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Authority": "https://securetoken.google.com/azim-crm",
    "Audience": "organization-api"
  },
  "MembershipCache": {
    "Ttl": "00:05:00"
  },
  "OutboxWorker": {
    "IntervalSeconds": 10,
    "BatchSize": 50
  },
  "IdentityPlatform": {
    "BaseUrl": "https://identitytoolkit.googleapis.com"
  },
  "Secrets": {
    "organization_token_pepper": "CHANGE_ME_IN_PRODUCTION_USE_SECRET_MANAGER"
  }
}
