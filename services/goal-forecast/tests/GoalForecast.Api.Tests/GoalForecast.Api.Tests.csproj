<Project Sdk="Microsoft.NET.Sdk">
  <!--
    GoalForecast.Api.Tests
    Foco: contratos HTTP, códigos de status, anti-enumeração, catálogo de erros (design §12),
          testes de contrato (TASK-26) e segurança RBAC (TASK-27).
    Usa WebApplicationFactory para testes de integração de API.
    Coverage mínima: ≥ 80% da camada Api (tasks.md §1).
    Mapeia: design §13, TASK-21..26.

    Nota: xUnit, FluentAssertions, FsCheck.Xunit e Microsoft.NET.Test.Sdk são injetados
    pelo Directory.Build.props para todos os projetos *.Tests.
  -->
  <PropertyGroup>
    <AssemblyName>GoalForecast.Api.Tests</AssemblyName>
    <RootNamespace>GoalForecast.Api.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GoalForecast.Api\GoalForecast.Api.csproj" />
    <ProjectReference Include="..\..\src\GoalForecast.Application\GoalForecast.Application.csproj" />
    <ProjectReference Include="..\..\src\GoalForecast.Infrastructure\GoalForecast.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\GoalForecast.Contracts\GoalForecast.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <!-- WebApplicationFactory para testes de integração de API -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
  </ItemGroup>
</Project>
