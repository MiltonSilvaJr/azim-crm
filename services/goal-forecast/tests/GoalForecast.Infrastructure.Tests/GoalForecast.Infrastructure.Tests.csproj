<Project Sdk="Microsoft.NET.Sdk">
  <!--
    GoalForecast.Infrastructure.Tests
    Foco: GoalRepository, GoalForecastDbContext (Global Query Filter, mapeamentos),
          PipelineForecastReader (circuit breaker, degradação), isolamento RLS (TASK-18).
    Usa Testcontainers para banco Postgres real em testes de integração.
    Mapeia: design §13, TASK-15..20.
  -->
  <PropertyGroup>
    <AssemblyName>GoalForecast.Infrastructure.Tests</AssemblyName>
    <RootNamespace>GoalForecast.Infrastructure.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GoalForecast.Infrastructure\GoalForecast.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\GoalForecast.Application\GoalForecast.Application.csproj" />
    <ProjectReference Include="..\..\src\GoalForecast.Domain\GoalForecast.Domain.csproj" />
    <ProjectReference Include="..\..\src\GoalForecast.Contracts\GoalForecast.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Testcontainers para PostgreSQL real em testes de integração (TASK-15..20) -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.4.0" />
    <!-- NSubstitute para stubs e mocks -->
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <!-- Microsoft.Extensions.Logging para DI em testes -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <!-- Npgsql standalone para conexões SQL diretas nos testes de RLS (TASK-18) -->
    <PackageReference Include="Npgsql" Version="9.0.4" />
  </ItemGroup>
</Project>
