<Project Sdk="Microsoft.NET.Sdk">
  <!--
    DataMigration.Infrastructure.Tests
    Foco: SpreadsheetParser (ClosedXML); portas in-process e UnitOfWork;
          isolamento RLS (Testcontainers/Postgres); idempotência por import_key.
    Gate de CI: teste de isolamento de tenant (RLS) como gate de merge (KPI-06).
    Rastreabilidade: Req 6, 7, 10, 12; RNF 2; design §6; tasks TASK-14..TASK-20.
    Gate de coverage: Infrastructure >= 70%.
  -->
  <PropertyGroup>
    <AssemblyName>DataMigration.Infrastructure.Tests</AssemblyName>
    <RootNamespace>DataMigration.Infrastructure.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DataMigration.Infrastructure\DataMigration.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\DataMigration.Application\DataMigration.Application.csproj" />
    <ProjectReference Include="..\..\src\DataMigration.Domain\DataMigration.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Testcontainers: PostgreSQL real para testes de integração RLS/EF Core -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.12.0" />
    <!-- NSubstitute: mocks para portas in-process -->
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <!-- ClosedXML: necessário para SpreadsheetFixtureBuilder nos testes -->
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <!-- Override de segurança: System.IO.Packaging 8.0.1+ resolve CVEs -->
    <PackageReference Include="System.IO.Packaging" Version="8.0.1" />
    <!-- FsCheck e FsCheck.Xunit já incluídos via Directory.Build.props para todos os projetos de teste -->
  </ItemGroup>
</Project>
