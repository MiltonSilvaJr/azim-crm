<Project Sdk="Microsoft.NET.Sdk">
  <!--
    DataMigration.Architecture.Tests
    Foco: regra de dependência entre camadas conforme design §3.
    Executa em 100% dos PRs; falha o CI em caso de violação.
    Mapeia: design §2 (princípios), design §3 (regras de dependência),
            TASK-02 (ST-01..ST-03).

    Regra de dependência validada:
      Api            -> Application, Infrastructure, Contracts (permitido)
      Application    -> Domain, Contracts (permitido; NUNCA Infrastructure)
      Infrastructure -> Application, Domain, Contracts (permitido)
      Domain         -> (nenhum projeto interno)
      Contracts      -> (nenhum projeto interno)

    Proibições extras (ST-03):
      ClosedXML fora de Infrastructure -> proibido
      EF Core fora de Infrastructure -> proibido no Domain

    Coverlet configurado via Directory.Build.props.
  -->
  <PropertyGroup>
    <AssemblyName>DataMigration.Architecture.Tests</AssemblyName>
    <RootNamespace>DataMigration.Architecture.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- NetArchTest para regras de arquitetura -->
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Referencia todos os projetos de produção para inspeção de assemblies -->
    <ProjectReference Include="..\..\src\DataMigration.Contracts\DataMigration.Contracts.csproj" />
    <ProjectReference Include="..\..\src\DataMigration.Domain\DataMigration.Domain.csproj" />
    <ProjectReference Include="..\..\src\DataMigration.Application\DataMigration.Application.csproj" />
    <ProjectReference Include="..\..\src\DataMigration.Infrastructure\DataMigration.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\DataMigration.Api\DataMigration.Api.csproj" />
  </ItemGroup>
</Project>
