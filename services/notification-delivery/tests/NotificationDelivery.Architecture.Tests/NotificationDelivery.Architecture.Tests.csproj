<Project Sdk="Microsoft.NET.Sdk">
  <!--
    NotificationDelivery.Architecture.Tests
    Foco: regra de dependência DD-003 + proibição de SDK de provedor fora da Infrastructure.
    Executa em 100% dos PRs; falha o CI em caso de violação (RNF 1, Req 1.2, Req 4.4).
    Coverlet configurado via Directory.Build.props.
  -->
  <PropertyGroup>
    <AssemblyName>NotificationDelivery.Architecture.Tests</AssemblyName>
    <RootNamespace>NotificationDelivery.Architecture.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- NetArchTest para regras de arquitetura -->
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Referencia todos os projetos de produção para inspeção de assemblies -->
    <ProjectReference Include="..\..\src\NotificationDelivery.Contracts\NotificationDelivery.Contracts.csproj" />
    <ProjectReference Include="..\..\src\NotificationDelivery.Application\NotificationDelivery.Application.csproj" />
    <ProjectReference Include="..\..\src\NotificationDelivery.Infrastructure\NotificationDelivery.Infrastructure.csproj" />
  </ItemGroup>
</Project>
