<Project Sdk="Microsoft.NET.Sdk">
  <!--
    OpportunityPipeline.Architecture.Tests
    Foco: regra de dependência entre camadas conforme design §3.
    Executa em 100% dos PRs; falha o CI em caso de violação.
    Mapeia: design §2 (princípios), §3 (regras de dependência), TASK-01.

    Regra de dependência validada:
      Api            -> Application, Infrastructure, Contracts (permitido)
      Application    -> Domain, Contracts (permitido; NUNCA Infrastructure)
      Infrastructure -> Application, Domain, Contracts (permitido)
      Domain         -> (nenhum projeto interno)
      Contracts      -> (nenhum projeto interno)

    Coverlet configurado via Directory.Build.props.
  -->
  <PropertyGroup>
    <AssemblyName>OpportunityPipeline.Architecture.Tests</AssemblyName>
    <RootNamespace>OpportunityPipeline.Architecture.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- NetArchTest para regras de arquitetura -->
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Referencia todos os projetos de produção para inspeção de assemblies -->
    <ProjectReference Include="..\..\src\OpportunityPipeline.Contracts\OpportunityPipeline.Contracts.csproj" />
    <ProjectReference Include="..\..\src\OpportunityPipeline.Domain\OpportunityPipeline.Domain.csproj" />
    <ProjectReference Include="..\..\src\OpportunityPipeline.Application\OpportunityPipeline.Application.csproj" />
    <ProjectReference Include="..\..\src\OpportunityPipeline.Infrastructure\OpportunityPipeline.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\OpportunityPipeline.Api\OpportunityPipeline.Api.csproj" />
  </ItemGroup>
</Project>
