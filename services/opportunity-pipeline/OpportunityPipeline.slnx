    <Project Path="src/OpportunityPipeline.Contracts/OpportunityPipeline.Contracts.csproj" />
    <Project Path="src/OpportunityPipeline.Domain/OpportunityPipeline.Domain.csproj" />
    <Project Path="src/OpportunityPipeline.Application/OpportunityPipeline.Application.csproj" />
    <Project Path="src/OpportunityPipeline.Infrastructure/OpportunityPipeline.Infrastructure.csproj" />
    <Project Path="src/OpportunityPipeline.Api/OpportunityPipeline.Api.csproj" />
