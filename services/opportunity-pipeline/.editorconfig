# EditorConfig — OpportunityPipeline
# Mantém consistência de formatação conforme convenções do repositório Azim CRM.
# Identifiers em inglês; documentação em português brasileiro.
# Referência: .forge/rules/conventions/language-policy.md

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,slnx}]
indent_size = 2

[*.{json,yaml,yml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# C# — alinhado com .NET 10 e as regras de código do repositório
[*.cs]
indent_size = 4
dotnet_style_qualification_for_field = false
dotnet_style_qualification_for_property = false
dotnet_style_qualification_for_method = false
dotnet_style_qualification_for_event = false

# Nullable: habilita via Directory.Build.props; aqui apenas reforço analítico
dotnet_diagnostic.CS8600.severity = error
dotnet_diagnostic.CS8601.severity = error
dotnet_diagnostic.CS8602.severity = error
dotnet_diagnostic.CS8603.severity = error
dotnet_diagnostic.CS8604.severity = error
dotnet_diagnostic.CS8618.severity = error
dotnet_diagnostic.CS8625.severity = error

# float/double proibidos em cálculos monetários (RNF 11, design §4.6)
# Analisadores garantem o resto; convencionar aqui para sinalização.
dotnet_diagnostic.CA1720.severity = warning

# Ordenação de usings
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Estilo de expressão
csharp_style_expression_bodied_methods = when_on_single_line
csharp_style_expression_bodied_properties = when_on_single_line
csharp_style_var_for_built_in_types = false
csharp_style_var_when_type_is_apparent = true
csharp_style_var_elsewhere = false
csharp_prefer_simple_default_expression = true
csharp_prefer_braces = true

# Namespaces file-scoped (C# moderno)
csharp_style_namespace_declarations = file_scoped:warning
