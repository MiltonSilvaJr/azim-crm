<Project Sdk="Microsoft.NET.Sdk">
  <!--
    OpportunityPipeline.Infrastructure
    Papel: adapters concretos — EF Core (OpportunityDbContext, mapeamentos snake_case,
           Global Query Filter por tenant_id, migrations das 7 tabelas), RLS via
           RlsConnectionInterceptor (SET app.current_tenant — DD-006, ADR-0001),
           OpportunityNumberGenerator (contador atômico por tenant — DD-001, PBT-01),
           OutboxPublisher (background service — ADR-0004), AuditPublisher + PiiMasker
           (RNF 6), adapters das portas de leitura (Organization, Account, Partner, Activity)
           via gRPC/HTTP com mTLS, trigger trg_block_snapshot_mutation (migration manual —
           RNF 5, DD-002), StaleScanEndpointHandler.
    Regra de dependência: Infrastructure -> Application, Domain, Contracts.
    Infrastructure é o único projeto autorizado a usar EF Core, Npgsql, Redis,
    StackExchange.Redis, GCP SDKs e drivers de mensageria.
    Mapeia: design §3, §6, TASK-13..18, ADR-0001, ADR-0004.
  -->
  <PropertyGroup>
    <AssemblyName>OpportunityPipeline.Infrastructure</AssemblyName>
    <RootNamespace>OpportunityPipeline.Infrastructure</RootNamespace>
    <Description>Adapters de infraestrutura do módulo opportunity-pipeline: EF Core, RLS, numeração atômica, Outbox, auditoria, adapters das portas de leitura. Único projeto autorizado a usar drivers de persistência e mensageria.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpportunityPipeline.Application\OpportunityPipeline.Application.csproj" />
    <ProjectReference Include="..\OpportunityPipeline.Domain\OpportunityPipeline.Domain.csproj" />
    <ProjectReference Include="..\OpportunityPipeline.Contracts\OpportunityPipeline.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core 9.0.6 — versão alinhada com os demais módulos do repositório -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.6" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.6">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.6" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="8.0.0" />
    <!-- Npgsql 9.0.4 — driver PostgreSQL alinhado com os demais módulos -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <!-- Redis para cache de configuração (StageRef, OriginChannelRef — design §6.2) -->
    <PackageReference Include="StackExchange.Redis" Version="2.8.31" />
    <!-- Resiliência: retry, circuit breaker, timeout nas portas externas (design §6.4) -->
    <PackageReference Include="Polly" Version="8.5.2" />
    <!-- Serilog: logs estruturados (RNF 10.1) -->
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <!-- Health checks: live e ready endpoints (RNF 12) -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.0" />
    <!-- HTTP client para adapters externos (portas de leitura — design §6.4) -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>
</Project>
