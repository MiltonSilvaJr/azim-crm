<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Authentication.Infrastructure
    Papel: adapters concretos de saída — FirebaseIdentityProvider (ÚNICO ponto de
           acoplamento ao GCP Identity Platform), JwksTokenVerifier, MembershipCacheRepository
           (Redis), SecretManagerProvider (GCP Secret Manager), OrganizationUserDirectory,
           TenantDirectory, RedisRateLimiter, IdentityProviderHealthCheck, extensões de DI.
    Regra de dependência (DD-001): referencia Application, Domain e Contracts.
    Confinamento ACL (DD-001): ÚNICO projeto que pode conter tipos do Firebase Admin SDK
    e o símbolo identity_uid. Architecture.Tests falha o build se vazarem para outros projetos.
  -->
  <PropertyGroup>
    <AssemblyName>Authentication.Infrastructure</AssemblyName>
    <RootNamespace>Authentication.Infrastructure</RootNamespace>
    <Description>Adapters de infraestrutura do módulo authentication: FirebaseIdentityProvider, JwksTokenVerifier, Redis, Secret Manager. Único projeto autorizado a usar Firebase Admin SDK e identity_uid (DD-001).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Authentication.Application\Authentication.Application.csproj" />
    <ProjectReference Include="..\Authentication.Domain\Authentication.Domain.csproj" />
    <ProjectReference Include="..\Authentication.Contracts\Authentication.Contracts.csproj" />
  </ItemGroup>
</Project>
